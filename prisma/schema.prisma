generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════

enum Portal {
  ADMIN
  CORPORATE
  EMPLOYEE
  SUPPLIER
  PARTNER_API
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DELETED
}

enum RoleType {
  INTERNAL
  EXTERNAL
  PARTNER
}

enum DataScope {
  GLOBAL
  CORPORATE
  BRANCH
  SELF
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum BookingVertical {
  HOTEL
  FLIGHT
  BUS
  CAB
  TRAIN
}

enum BookingStatus {
  INITIATED
  HELD
  CONFIRMED
  TICKETED
  CANCELLED
  MODIFIED
  FAILED
}

enum CredentialMode {
  SANDBOX
  PRODUCTION
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum SagaStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  COMPENSATED
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum HealthStatusEnum {
  HEALTHY
  DEGRADED
  DOWN
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

// ═══════════════════════════════════════════════════════════
// Platform
// ═══════════════════════════════════════════════════════════

model OutboxEvent {
  id            String       @id @default(cuid())
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  eventType     String       @map("event_type") @db.VarChar(128)
  payload       Json
  headers       Json?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  createdAt     DateTime     @default(now()) @map("created_at")
  publishedAt   DateTime?    @map("published_at")

  @@index([status, createdAt])
  @@map("outbox_event")
}

model IdempotencyRecord {
  id           String            @id @default(cuid())
  scope        String            @db.VarChar(64)
  key          String            @db.VarChar(128)
  corporateId  String?           @map("corporate_id") @db.VarChar(64)
  requestHash  String            @map("request_hash") @db.VarChar(128)
  responseJson Json?             @map("response_json")
  status       IdempotencyStatus @default(IN_PROGRESS)
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("platform_idempotency")
}

// ═══════════════════════════════════════════════════════════
// Auth
// ═══════════════════════════════════════════════════════════

model AuthUserAccount {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(320)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  mfaEnabled   Boolean    @default(false) @map("mfa_enabled")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at")
  corporateId  String?    @map("corporate_id") @db.VarChar(64)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens AuthRefreshToken[]
  ssoIdentities AuthSsoIdentity[]

  @@index([corporateId])
  @@map("auth_user_account")
}

model AuthRefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(128)
  familyId  String    @map("family_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  user AuthUserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("auth_refresh_token")
}

model AuthSsoIdentity {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  provider   String   @db.VarChar(32)
  issuer     String   @db.VarChar(512)
  subject    String   @db.VarChar(255)
  rawClaims  Json?    @map("raw_claims")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user AuthUserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
  @@map("auth_sso_identity")
}

model AuthApiClient {
  id               String   @id @default(cuid())
  clientId         String   @unique @map("client_id") @db.VarChar(64)
  clientSecretHash String   @map("client_secret_hash") @db.VarChar(255)
  name             String   @db.VarChar(128)
  portal           Portal   @default(PARTNER_API)
  rateLimitPlan    String   @default("standard") @map("rate_limit_plan") @db.VarChar(32)
  corporateId      String?  @map("corporate_id") @db.VarChar(64)
  scopes           Json
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([corporateId])
  @@map("auth_api_client")
}

/// Admin portal (Misba Supervision) users — email/password auth.
model AdminUser {
  id                  String     @id @default(cuid())
  email               String     @unique @db.VarChar(320)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  firstName           String     @map("first_name") @db.VarChar(128)
  lastName            String     @map("last_name") @db.VarChar(128)
  displayName         String     @map("display_name") @db.VarChar(255)
  phone               String?    @db.VarChar(32)
  address             String?    @db.VarChar(512)
  roleCode            String     @default("ADMIN") @map("role_code") @db.VarChar(64)
  roleName            String     @default("Admin") @map("role_name") @db.VarChar(128)
  status              UserStatus @default(ACTIVE)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  mfaSecret           String?    @map("mfa_secret") @db.VarChar(255)
  lastLoginAt         DateTime?  @map("last_login_at")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  passwordChangedAt   DateTime?  @map("password_changed_at")
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  isEmailVerified     Boolean    @default(true) @map("is_email_verified")
  createdBy           String?    @map("created_by") @db.VarChar(64)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  refreshTokens AdminRefreshToken[]

  @@index([status])
  @@index([roleCode])
  @@map("auth_admin_user")
}

model AdminRefreshToken {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  tokenHash String    @map("token_hash") @db.VarChar(128)
  familyId  String    @map("family_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(512)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("auth_admin_refresh_token")
}

// ═══════════════════════════════════════════════════════════
// User
// ═══════════════════════════════════════════════════════════

model UserProfile {
  id          String     @id @default(cuid())
  authUserId  String     @unique @map("auth_user_id") @db.VarChar(64)
  corporateId String?    @map("corporate_id") @db.VarChar(64)
  displayName String     @map("display_name") @db.VarChar(255)
  phone       String?    @db.VarChar(32)
  timezone    String     @default("UTC") @db.VarChar(64)
  locale      String     @default("en-IN") @db.VarChar(16)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  roleAssignments UserRoleAssignment[]

  @@index([corporateId])
  @@map("user_profile")
}

model PermissionModule {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(128)
  sortOrder Int      @default(0) @map("sort_order")
  tone      String?  @db.VarChar(64)
  status    String   @default("ACTIVE") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions Permission[]

  @@index([status])
  @@map("user_permission_module")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  moduleId    String   @map("module_id")
  description String?  @db.VarChar(250)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("ACTIVE") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  module     PermissionModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roleGrants RolePermission[]

  @@index([moduleId])
  @@index([status])
  @@map("user_permission")
}

model Role {
  id                   String     @id @default(cuid())
  code                 String     @unique @db.VarChar(64)
  name                 String     @db.VarChar(128)
  description          String?    @db.VarChar(250)
  roleType             RoleType   @map("role_type")
  dataScope            DataScope  @map("data_scope")
  status               RoleStatus @default(ACTIVE)
  makerCheckerRequired Boolean    @default(false) @map("maker_checker_required")
  corporateId          String?    @map("corporate_id") @db.VarChar(64)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([status])
  @@index([roleType])
  @@index([dataScope])
  @@index([corporateId])
  @@map("user_role")
}

model RolePermission {
  id           String  @id @default(cuid())
  roleId       String  @map("role_id")
  permissionId String  @map("permission_id")
  canView      Boolean @default(false) @map("can_view")
  canCreate    Boolean @default(false) @map("can_create")
  canEdit      Boolean @default(false) @map("can_edit")
  canDelete    Boolean @default(false) @map("can_delete")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("user_role_permission")
}

model UserRoleAssignment {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  roleId      String  @map("role_id")
  corporateId String? @map("corporate_id") @db.VarChar(64)
  scope       Json?

  user UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, corporateId])
  @@map("user_role_assignment")
}

// ═══════════════════════════════════════════════════════════
// Corporate
// ═══════════════════════════════════════════════════════════

model Corporate {
  id              String   @id @default(cuid())
  code            String   @unique @db.VarChar(64)
  legalName       String   @map("legal_name") @db.VarChar(255)
  status          String   @default("ACTIVE") @db.VarChar(32)
  defaultCurrency String   @default("INR") @map("default_currency") @db.VarChar(3)
  timezone        String   @default("Asia/Kolkata") @db.VarChar(64)
  settings        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  employees   CorporateEmployee[]
  departments Department[]
  costCenters CostCenter[]

  @@map("corporate_company")
}

/// Lightweight corporate code master used by "Create Corporate Code" UI.
model CorporateCode {
  id              String   @id @default(cuid())
  code            String   @unique @db.VarChar(64)
  name            String   @db.VarChar(255)
  corporateType   String   @map("corporate_type") @db.VarChar(64)
  defaultCountry  String   @map("default_country") @db.VarChar(64)
  defaultCurrency String   @map("default_currency") @db.VarChar(3)
  pricingModel    String   @map("pricing_model") @db.VarChar(64)
  gstApplicable   Boolean  @default(true) @map("gst_applicable")
  status          String   @default("ACTIVE") @db.VarChar(32)
  primaryContact  String?  @map("primary_contact") @db.VarChar(128)
  email           String?  @db.VarChar(320)
  phone           String?  @db.VarChar(32)
  remarks         String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([corporateType])
  @@index([defaultCountry])
  @@map("corporate_code")
}

model Department {
  id          String @id @default(cuid())
  corporateId String @map("corporate_id")
  name        String @db.VarChar(128)
  code        String @db.VarChar(64)

  corporate Corporate           @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  employees CorporateEmployee[]

  @@unique([corporateId, code])
  @@map("corporate_department")
}

model CostCenter {
  id          String @id @default(cuid())
  corporateId String @map("corporate_id")
  name        String @db.VarChar(128)
  code        String @db.VarChar(64)
  budgetJson  Json?  @map("budget_json")

  corporate Corporate           @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  employees CorporateEmployee[]

  @@unique([corporateId, code])
  @@map("corporate_cost_center")
}

model CorporateEmployee {
  id                String  @id @default(cuid())
  corporateId       String  @map("corporate_id")
  userId            String? @map("user_id") @db.VarChar(64)
  employeeCode      String  @map("employee_code") @db.VarChar(64)
  email             String  @db.VarChar(320)
  departmentId      String? @map("department_id")
  costCenterId      String? @map("cost_center_id")
  grade             String? @db.VarChar(32)
  managerEmployeeId String? @map("manager_employee_id") @db.VarChar(64)
  status            String  @default("ACTIVE") @db.VarChar(32)

  corporate  Corporate   @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@unique([corporateId, employeeCode])
  @@index([corporateId, email])
  @@map("corporate_employee")
}

// ═══════════════════════════════════════════════════════════
// Supplier
// ═══════════════════════════════════════════════════════════

model Supplier {
  id              String   @id @default(cuid())
  code            String   @unique @db.VarChar(64)
  name            String   @db.VarChar(128)
  enabled         Boolean  @default(false)
  defaultPriority Int      @default(100) @map("default_priority")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  credentials     SupplierCredential[]
  verticalConfigs SupplierVerticalConfig[]
  rules           SupplierRule[]
  healthRecords   SupplierHealth[]

  @@map("supplier_supplier")
}

model SupplierCredential {
  id         String         @id @default(cuid())
  supplierId String         @map("supplier_id")
  mode       CredentialMode @default(SANDBOX)
  ciphertext String         @db.Text
  iv         String         @db.VarChar(64)
  authTag    String         @map("auth_tag") @db.VarChar(64)
  kekVersion String         @default("v1") @map("kek_version") @db.VarChar(16)
  rotatedAt  DateTime?      @map("rotated_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, mode])
  @@map("supplier_credential")
}

model SupplierVerticalConfig {
  id              String           @id @default(cuid())
  supplierId      String           @map("supplier_id")
  vertical        BookingVertical
  enabled         Boolean          @default(true)
  priority        Int              @default(100)
  baseUrl         String           @map("base_url") @db.VarChar(512)
  timeoutMs       Int              @default(8000) @map("timeout_ms")
  rateLimitPerSec Int              @default(20) @map("rate_limit_per_sec")
  markupGroup     String?          @map("markup_group") @db.VarChar(64)
  capabilities    Json?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, vertical])
  @@map("supplier_vertical_config")
}

model SupplierRule {
  id                 String           @id @default(cuid())
  supplierId         String           @map("supplier_id")
  vertical           BookingVertical?
  corporateId        String?          @map("corporate_id") @db.VarChar(64)
  marketCountry      String?          @map("market_country") @db.VarChar(2)
  destinationPattern String?          @map("destination_pattern") @db.VarChar(128)
  priorityOverride   Int?             @map("priority_override")
  enabled            Boolean          @default(true)
  windowStart        DateTime?        @map("window_start")
  windowEnd          DateTime?        @map("window_end")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, vertical, corporateId])
  @@map("supplier_rule")
}

model SupplierHealth {
  id            String           @id @default(cuid())
  supplierId    String           @map("supplier_id")
  vertical      BookingVertical
  status        HealthStatusEnum @default(HEALTHY)
  circuitState  CircuitState     @default(CLOSED) @map("circuit_state")
  lastCheckedAt DateTime         @default(now()) @map("last_checked_at")
  details       Json?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, vertical])
  @@map("supplier_health")
}

// ═══════════════════════════════════════════════════════════
// Booking
// ═══════════════════════════════════════════════════════════

model Booking {
  id                 String           @id @default(cuid())
  bookingRef         String           @unique @map("booking_ref") @db.VarChar(64)
  corporateId        String           @map("corporate_id") @db.VarChar(64)
  userId             String           @map("user_id") @db.VarChar(64)
  vertical           BookingVertical
  status             BookingStatus    @default(INITIATED)
  supplierCode       String?          @map("supplier_code") @db.VarChar(64)
  supplierBookingRef String?          @map("supplier_booking_ref") @db.VarChar(128)
  offerSnapshot      Json             @map("offer_snapshot")
  priceBreakdown     Json             @map("price_breakdown")
  currency           String           @db.VarChar(3)
  travellers         Json
  idempotencyKey     String           @map("idempotency_key") @db.VarChar(128)
  heldUntil          DateTime?        @map("held_until")
  confirmedAt        DateTime?        @map("confirmed_at")
  cancelledAt        DateTime?        @map("cancelled_at")
  correlationId      String           @map("correlation_id") @db.VarChar(64)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  transitions BookingStateTransition[]
  sagaSteps   BookingSagaStep[]

  @@unique([corporateId, idempotencyKey])
  @@index([corporateId, status])
  @@index([userId])
  @@map("booking_booking")
}

model BookingStateTransition {
  id        String         @id @default(cuid())
  bookingId String         @map("booking_id")
  fromStatus BookingStatus @map("from_status")
  toStatus   BookingStatus @map("to_status")
  reason    String?        @db.VarChar(255)
  actorId   String?        @map("actor_id") @db.VarChar(64)
  meta      Json?
  createdAt DateTime       @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_state_transition")
}

model BookingSagaStep {
  id             String         @id @default(cuid())
  bookingId      String         @map("booking_id")
  step           String         @db.VarChar(64)
  status         SagaStepStatus @default(PENDING)
  attempt        Int            @default(0)
  lastError      String?        @map("last_error") @db.Text
  compensationOf String?        @map("compensation_of") @db.VarChar(64)
  idempotencyKey String         @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, step, idempotencyKey])
  @@index([bookingId, status])
  @@map("booking_saga_step")
}

// ═══════════════════════════════════════════════════════════
// Audit
// ═══════════════════════════════════════════════════════════

/// Immutable audit / activity timeline for Misba Supervision.
model AuditLog {
  id            String   @id @default(cuid())
  corporateId   String?  @map("corporate_id") @db.VarChar(64)
  actorId       String?  @map("actor_id") @db.VarChar(64)
  actorType     String?  @map("actor_type") @db.VarChar(32)
  actorName     String?  @map("actor_name") @db.VarChar(255)
  actorEmail    String?  @map("actor_email") @db.VarChar(320)
  action        String   @db.VarChar(64)
  resourceType  String   @map("resource_type") @db.VarChar(64)
  resourceId    String?  @map("resource_id") @db.VarChar(64)
  targetLabel   String?  @map("target_label") @db.VarChar(255)
  result        String   @default("SUCCESS") @db.VarChar(32)
  beforeJson    Json?    @map("before_json")
  afterJson     Json?    @map("after_json")
  metadata      Json?
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(512)
  correlationId String   @map("correlation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([corporateId, createdAt])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([result, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

// ═══════════════════════════════════════════════════════════
// Master data (minimal)
// ═══════════════════════════════════════════════════════════

model Country {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(2)
  name String @db.VarChar(128)

  cities City[]

  @@map("master_country")
}

model City {
  id          String  @id @default(cuid())
  countryId   String  @map("country_id")
  code        String  @db.VarChar(16)
  name        String  @db.VarChar(128)
  timezone    String? @db.VarChar(64)
  latitude    Float?
  longitude   Float?

  country Country @relation(fields: [countryId], references: [id])

  @@unique([countryId, code])
  @@map("master_city")
}

model HotelMapping {
  id              String @id @default(cuid())
  mtwHotelId      String @map("mtw_hotel_id") @db.VarChar(64)
  supplierCode    String @map("supplier_code") @db.VarChar(64)
  supplierHotelId String @map("supplier_hotel_id") @db.VarChar(128)
  confidence      Float  @default(1)
  reviewStatus    String @default("AUTO") @map("review_status") @db.VarChar(32)

  @@unique([supplierCode, supplierHotelId])
  @@index([mtwHotelId])
  @@map("master_hotel_mapping")
}

// ═══════════════════════════════════════════════════════════
// Payment
// ═══════════════════════════════════════════════════════════

model Payment {
  id            String   @id @default(cuid())
  bookingId     String?  @map("booking_id")
  corporateId   String   @map("corporate_id")
  provider      String   @db.VarChar(32)
  providerRef   String?  @map("provider_ref") @db.VarChar(128)
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @db.VarChar(3)
  status        String   @db.VarChar(32)
  idempotencyKey String  @unique @map("idempotency_key") @db.VarChar(128)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([corporateId, createdAt])
  @@index([bookingId])
  @@map("payment_payment")
}

model PaymentRefund {
  id          String   @id @default(cuid())
  paymentId   String   @map("payment_id")
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @db.VarChar(3)
  status      String   @db.VarChar(32)
  providerRef String?  @map("provider_ref") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@map("payment_refund")
}

// ═══════════════════════════════════════════════════════════
// Policy & Approval
// ═══════════════════════════════════════════════════════════

model TravelPolicy {
  id               String   @id @default(cuid())
  corporateId      String?  @map("corporate_id") @db.VarChar(64)
  name             String   @db.VarChar(128)
  code             String   @unique @db.VarChar(64)
  policyType       String   @default("STANDARD") @map("policy_type") @db.VarChar(64)
  description      String?  @db.VarChar(250)
  applicableTo     String   @default("ALL_EMPLOYEES") @map("applicable_to") @db.VarChar(64)
  status           String   @default("DRAFT") @db.VarChar(32)
  currentStep      Int      @default(1) @map("current_step")
  completedSteps   Json?    @map("completed_steps")
  travelRules      Json?    @map("travel_rules")
  spendingLimits   Json?    @map("spending_limits")
  approvalWorkflow Json?    @map("approval_workflow")
  assignment       Json?
  createdBy        String?  @map("created_by") @db.VarChar(128)
  updatedBy        String?  @map("updated_by") @db.VarChar(128)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([corporateId])
  @@index([status])
  @@index([policyType])
  @@map("policy_travel_policy")
}

model ApprovalRequest {
  id          String   @id @default(cuid())
  corporateId String   @map("corporate_id")
  bookingId   String?  @map("booking_id")
  requesterId String   @map("requester_id")
  status      String   @db.VarChar(32)
  levels      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([corporateId, status])
  @@map("policy_approval_request")
}

// ═══════════════════════════════════════════════════════════
// Trip / Cost / CMS / Notification
// ═══════════════════════════════════════════════════════════

model Trip {
  id          String   @id @default(cuid())
  corporateId String   @map("corporate_id")
  ownerId     String   @map("owner_id")
  title       String   @db.VarChar(256)
  status      String   @db.VarChar(32)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([corporateId, ownerId])
  @@map("trip_trip")
}

model CostSaving {
  id          String   @id @default(cuid())
  corporateId String   @map("corporate_id")
  bookingId   String?  @map("booking_id")
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @db.VarChar(3)
  reason      String   @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([corporateId])
  @@map("cost_saving")
}

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(128)
  title     String   @db.VarChar(256)
  body      Json
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("cms_page")
}

model CmsBanner {
  id        String   @id @default(cuid())
  portal    String   @db.VarChar(32)
  title     String   @db.VarChar(256)
  payload   Json
  active    Boolean  @default(true)
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([portal, active])
  @@map("cms_banner")
}

model NotificationOutbox {
  id          String   @id @default(cuid())
  channel     String   @db.VarChar(32)
  toAddress   String   @map("to_address") @db.VarChar(256)
  template    String   @db.VarChar(128)
  payload     Json
  status      String   @db.VarChar(32)
  providerRef String?  @map("provider_ref") @db.VarChar(128)
  createdAt   DateTime @default(now()) @map("created_at")
  sentAt      DateTime? @map("sent_at")

  @@index([status, createdAt])
  @@map("notification_outbox")
}

/// Markup rules used by Create Markup Rule UI (Flight/Hotel/Car/Train/Bus).
model MarkupRule {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(128)
  productType  String    @map("product_type") @db.VarChar(16)
  markupType   String    @map("markup_type") @db.VarChar(32)
  markupValue  Decimal   @map("markup_value") @db.Decimal(12, 4)
  applicableTo String    @map("applicable_to") @db.VarChar(64)
  priority     Int       @default(1)
  validFrom    DateTime? @map("valid_from")
  validTo      DateTime? @map("valid_to")
  status       String    @default("ACTIVE") @db.VarChar(32)
  conditions   Json?
  remarks      String?   @db.Text
  corporateId  String?   @map("corporate_id") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([productType, status])
  @@index([applicableTo])
  @@index([priority])
  @@index([corporateId])
  @@map("pricing_markup_rule")
}

model SupplierCommission {
  id             String    @id @default(cuid())
  supplierName   String    @map("supplier_name") @db.VarChar(128)
  productType    String    @map("product_type") @db.VarChar(16)
  commissionType String    @map("commission_type") @db.VarChar(32)
  value          Decimal   @db.Decimal(12, 4)
  validFrom      DateTime? @map("valid_from")
  validTo        DateTime? @map("valid_to")
  status         String    @default("ACTIVE") @db.VarChar(32)
  remarks        String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([supplierName])
  @@index([productType, status])
  @@map("pricing_supplier_commission")
}

model ServiceFee {
  id           String   @id @default(cuid())
  feeName      String   @map("fee_name") @db.VarChar(128)
  productType  String   @map("product_type") @db.VarChar(32)
  feeType      String   @map("fee_type") @db.VarChar(32)
  value        Decimal  @db.Decimal(12, 4)
  applicableTo String   @map("applicable_to") @db.VarChar(64)
  status       String   @default("ACTIVE") @db.VarChar(32)
  remarks      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([productType, status])
  @@index([applicableTo])
  @@map("pricing_service_fee")
}

model ConvenienceFee {
  id           String   @id @default(cuid())
  feeName      String   @map("fee_name") @db.VarChar(128)
  productType  String   @map("product_type") @db.VarChar(32)
  channel      String   @db.VarChar(32)
  value        Decimal  @db.Decimal(12, 4)
  applicableTo String   @map("applicable_to") @db.VarChar(64)
  status       String   @default("ACTIVE") @db.VarChar(32)
  remarks      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([productType, status])
  @@index([channel])
  @@map("pricing_convenience_fee")
}

model DiscountRule {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(128)
  productType     String    @map("product_type") @db.VarChar(32)
  discountType    String    @map("discount_type") @db.VarChar(32)
  value           Decimal   @db.Decimal(12, 4)
  minBookingValue Decimal   @default(0) @map("min_booking_value") @db.Decimal(12, 4)
  validFrom       DateTime? @map("valid_from")
  validTo         DateTime? @map("valid_to")
  status          String    @default("ACTIVE") @db.VarChar(32)
  remarks         String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([productType, status])
  @@index([discountType])
  @@map("pricing_discount_rule")
}

model GstRule {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(128)
  productType   String   @map("product_type") @db.VarChar(32)
  gstType       String   @map("gst_type") @db.VarChar(16)
  gstPercentage Decimal  @map("gst_percentage") @db.Decimal(8, 4)
  applicableFor String   @map("applicable_for") @db.VarChar(32)
  status        String   @default("ACTIVE") @db.VarChar(32)
  remarks       String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([productType, status])
  @@index([gstType])
  @@index([applicableFor])
  @@map("pricing_gst_rule")
}
