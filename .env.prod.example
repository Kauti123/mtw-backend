# Copy to .env.prod on the AWS server (never commit secrets).
# cp .env.prod.example .env.prod && nano .env.prod

# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=production
DEPLOY_MODE=monolith
PORT=4000
APP_NAME=mtw-api-gateway
LOG_LEVEL=info

# ─── Domains / CORS ──────────────────────────────────────────
CORS_ORIGINS=https://admin.yourdomain.com,https://corporate.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
CORPORATE_DOMAIN=corporate.yourdomain.com
EMPLOYEE_DOMAIN=employee.yourdomain.com
SUPPLIER_DOMAIN=supplier.yourdomain.com
API_DOMAIN=api.yourdomain.com

# ─── External MySQL (RDS / remote) ───────────────────────────
# Allow the EC2 security group / public IP on the DB firewall.
DB_HOST=your-rds-or-mysql-host
DB_PORT=3306
DB_USERNAME=your_user
DB_PASSWORD=your_password
DB_NAME=misba
DATABASE_URL=mysql://your_user:your_password@your-rds-or-mysql-host:3306/misba
DATABASE_REPLICA_URL=

# ─── Redis / NATS (overridden to service names in compose) ───
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=mtw:
NATS_URL=nats://nats:4222
MESSAGING_TRANSPORT=nats

# ─── Auth / Security (generate strong secrets) ───────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=mtw-backend
JWT_AUDIENCE=mtw-api
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── AWS S3 ──────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=mtw-documents
# Leave empty for real AWS S3 (no LocalStack)
S3_ENDPOINT=

# ─── Observability ───────────────────────────────────────────
OTEL_ENABLED=false
METRICS_ENABLED=true
