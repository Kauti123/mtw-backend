{
  "name": "@mtw/backend",
  "version": "0.1.0",
  "private": true,
  "description": "MTW Corporate Travel Platform – Backend (NestJS modular monolith)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.9.1"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "nx run-many -t build",
    "build:gateway": "nx build api-gateway",
    "start:gateway": "nx serve api-gateway",
    "start:monolith": "cross-env DEPLOY_MODE=monolith nx serve api-gateway",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:cov": "nx run-many -t test --coverage",
    "test:e2e": "nx e2e api-gateway-e2e",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "gen:adapter": "tsx tools/generators/adapter/generate.ts",
    "gen:service": "tsx tools/generators/service/generate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod:install": "pnpm install --frozen-lockfile && pnpm prisma:generate",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml --env-file .env.prod build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --no-build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.prod down",
    "docker:prod:deploy": "pnpm docker:prod:install && pnpm docker:prod:build && pnpm docker:prod:up",
    "ci": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.901.0",
    "@aws-sdk/s3-request-presigner": "3.901.0",
    "@casl/ability": "6.7.3",
    "@casl/prisma": "1.5.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/bullmq": "11.0.2",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/microservices": "11.2.7",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.62.0",
    "@opentelemetry/sdk-node": "0.203.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/extension-read-replicas": "0.5.0",
    "@sesamecare-oss/redlock": "1.4.0",
    "argon2": "0.43.1",
    "bullmq": "5.58.5",
    "fastify": "5.12.5",
    "ioredis": "5.8.2",
    "jsonata": "2.2.2",
    "nats": "2.29.3",
    "nestjs-pino": "4.4.0",
    "nestjs-zod": "4.3.1",
    "openid-client": "6.8.8",
    "opossum": "8.5.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "undici": "7.16.0",
    "uuid": "11.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.36.0",
    "@nestjs/testing": "11.2.7",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@swc-node/register": "1.10.10",
    "@swc/core": "1.13.5",
    "@testcontainers/mysql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.5.2",
    "@types/opossum": "8.1.8",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "6.0.3",
    "@types/uuid": "10.0.0",
    "cross-env": "10.0.0",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "nock": "14.0.10",
    "nx": "23.2.1",
    "pino-pretty": "13.1.1",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
