# ─── Runtime ─────────────────────────────────────────────────
NODE_ENV=development
DEPLOY_MODE=monolith
PORT=4000
APP_NAME=mtw-api-gateway
LOG_LEVEL=info

# ─── Domains / CORS ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
ADMIN_DOMAIN=admin.mtw.local
CORPORATE_DOMAIN=corporate.mtw.local
EMPLOYEE_DOMAIN=employee.mtw.local
SUPPLIER_DOMAIN=supplier.mtw.local
API_DOMAIN=api.mtw.local

# ─── MySQL ───────────────────────────────────────────────────
# Discrete fields are used by phpMyAdmin and also build DATABASE_URL if it is omitted.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=mtw
DB_PASSWORD=mtw_secret
DB_NAME=mtw
DATABASE_URL=mysql://mtw:mtw_secret@localhost:3306/mtw
DATABASE_REPLICA_URL=mysql://mtw:mtw_secret@localhost:3307/mtw

# ─── phpMyAdmin (docker compose) ─────────────────────────────
PHPMYADMIN_PORT=8080

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=mtw:

# ─── NATS ────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
MESSAGING_TRANSPORT=nats

# ─── Auth / Security ─────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=mtw-backend
JWT_AUDIENCE=mtw-api
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ─── AWS S3 ──────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
S3_BUCKET=mtw-documents-local
S3_ENDPOINT=http://localhost:4566

# ─── Observability ───────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
